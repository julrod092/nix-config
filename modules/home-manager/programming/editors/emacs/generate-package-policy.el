;;; generate-package-policy.el --- Inspect the Nix package tree -*- lexical-binding: t; -*-
(setq native-comp-jit-compilation nil)
(require 'json)

(let* ((root (pop command-line-args-left))
       (policy (pop command-line-args-left))
       (output (pop command-line-args-left))
       packages)
  (unless (and root policy output)
    (error "Expected site ELPA directory, policy source and output directory"))
  ;; The wrapper's tree contains symlinked directories for the entire propagated
  ;; package closure. Read descriptor forms as data, never evaluate package code.
  (dolist (directory (directory-files root t "^[^.].*"))
    (when (file-directory-p directory)
      (dolist (descriptor (directory-files directory t "-pkg\\.el\\'"))
        (with-temp-buffer
          (insert-file-contents descriptor)
          (let ((form (read (current-buffer))))
            (unless (and (eq (car-safe form) 'define-package)
                         (stringp (nth 1 form)) (stringp (nth 2 form))
                         (string-match-p "\\`[a-zA-Z0-9_-]+\\'" (nth 1 form)))
              (error "Invalid package descriptor: %s" descriptor))
            (push `((name . ,(nth 1 form)) (version . ,(nth 2 form))
                    (directory . ,directory)) packages))))))
  (setq packages (sort packages (lambda (a b) (string< (alist-get 'name a) (alist-get 'name b)))))
  (let ((names (delete-dups (mapcar (lambda (entry) (alist-get 'name entry)) packages))))
    (with-temp-file (expand-file-name "nix-packages.el" output)
      (insert ";;; Generated by Nix; do not edit. -*- lexical-binding: t; -*-\n")
      (prin1 `(defconst nh-emacs-nix-package-names ',(mapcar #'intern names)) (current-buffer))
      (insert "\n")
      (prin1 `(defconst nh-emacs-nix-package-directory ,root) (current-buffer))
      (insert "\n")
      (prin1 `(load ,policy nil t) (current-buffer))
      (insert "\n"))
    (with-temp-file (expand-file-name "packages.json" output)
      (insert (json-encode `((owned_packages . ,(vconcat names))
                             (packages . ,(vconcat packages)))))
      (insert "\n"))))

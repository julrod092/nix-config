#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 4 ]]; then
  printf '%s\n' "Usage: fleet-bcrypt-secret READ_SECRET HTPASSWD EXTRACT_PATH SOPS_FILE" >&2
  exit 1
fi

readSecret="$1"
htpasswd="$2"
extractPath="$3"
sopsFile="$4"

if [[ ! -r "$readSecret" ]]; then
  printf 'Secret reader is unavailable: %s\n' "$readSecret" >&2
  exit 1
fi

if [[ ! -x "$htpasswd" ]]; then
  printf 'Required executable is unavailable: %s\n' "$htpasswd" >&2
  exit 1
fi

hashOutput="$("$BASH" "$readSecret" "$extractPath" "$sopsFile" | "$htpasswd" -niBC 12 "")"
hash="${hashOutput#*:}"

if [[ "$hash" == "$hashOutput" || ! "$hash" =~ ^\$2[aby]\$12\$[./A-Za-z0-9]{53}$ ]]; then
  printf '%s\n' "Failed to derive a valid bcrypt cost-12 verifier." >&2
  exit 1
fi

printf '%s' "$hash"

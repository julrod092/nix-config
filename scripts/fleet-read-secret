#!/usr/bin/env bash
set -euo pipefail

expectedRecipient="9F36F6D8FFE85CB8AF42592ACC597166004906B8"
expectedEncryptionKey="464D88CBD2EC1F2E28A2BD536F87DB9F966D6037"

if [[ "$(hostname)" != "nix-desktop" ]]; then
  printf '%s\n' "Secrets may only be decrypted on nix-desktop." >&2
  exit 1
fi

if [[ $# -ne 2 ]]; then
  printf '%s\n' "Usage: fleet-read-secret EXTRACT_PATH SOPS_FILE" >&2
  exit 1
fi

for commandName in gpg sops; do
  if ! command -v "$commandName" >/dev/null; then
    printf 'Required command not found: %s\n' "$commandName" >&2
    exit 1
  fi
done

secretKeys="$(gpg --batch --with-colons --list-secret-keys "$expectedRecipient")"
if [[ ":$secretKeys:" != *":$expectedRecipient:"* ]]; then
  printf '%s\n' "The expected fleet-controller secret key is unavailable." >&2
  exit 1
fi

cardStatus="$(gpg --batch --with-colons --card-status)"
if [[ ":$cardStatus:" != *":$expectedEncryptionKey:"* ]]; then
  printf '%s\n' "The expected fleet-controller hardware key is not attached." >&2
  exit 1
fi

exec sops --decrypt --extract "$1" "$2"

#!/usr/bin/env bash
set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"

required=(
  .sops.yaml
  hosts/nix-desktop/secrets.yaml
  hosts/nix-desktop/tailscale.sops.json
  hosts/nix-mac/secrets.yaml
)
for path in "${required[@]}"; do
  if [[ ! -f "$path" ]]; then
    printf 'Required encrypted configuration is missing: %s\n' "$path" >&2
    exit 1
  fi
done

for forbidden in fleet hosts/prime-mini home/homelab modules/home-manager/roles/homelab modules/home-manager/services/stacks modules/nixos/roles/server vendor/framework docs/superpowers .private secrets policies .synthetic-secret-placeholders; do
  if [[ -e "$forbidden" ]]; then
    printf 'Private or temporary path is forbidden in the public tree: %s\n' "$forbidden" >&2
    exit 1
  fi
done

mapfile -t candidates < <(
  {
    git ls-files
    git ls-files --others --exclude-standard
  } | sort --unique
)
for path in "${candidates[@]}"; do
  case "$path" in
    fleet/* | hosts/prime-mini/* | home/homelab/* | modules/home-manager/roles/homelab/* | modules/home-manager/services/stacks/* | modules/nixos/roles/server/* | vendor/framework/* | docs/superpowers/* | .private/* | secrets/* | policies/* | .synthetic-secret-placeholders/* | scripts/deploy-prime-mini | scripts/fleet-*)
      printf 'Private or temporary path is forbidden in the public tree or index: %s\n' "$path" >&2
      exit 1
      ;;
    hosts/nix-desktop/secrets.yaml | hosts/nix-desktop/tailscale.sops.json | hosts/nix-mac/secrets.yaml) ;;
    */secrets.yaml | */tailscale.sops.json)
      printf 'Encrypted payload is outside its approved host path: %s\n' "$path" >&2
      exit 1
      ;;
  esac
done
